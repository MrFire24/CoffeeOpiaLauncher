From f9a2620c9457977a75b7b5599e531c8948c988e2 Mon Sep 17 00:00:00 2001
From: Mr_Fire_ <vadimzhunda@gmail.com>
Date: Thu, 2 Jul 2026 15:41:13 +0300
Subject: [PATCH 2/2] fix(mods): stop silently ignoring mods; read
 neoforge.mods.toml

Three fixes for mods that Nebula would silently drop or mis-handle:
- Read META-INF/neoforge.mods.toml (NeoForge 1.20.5+) with fallback to
  META-INF/mods.toml, so NeoForge mods get their real id/name/version instead
  of a filename guess.
- Warn about jars placed directly in the forge/neoforge mods folder root: only
  the required/optionalon/optionaloff subfolders are scanned, so such files were
  silently ignored.
- Warn on duplicate resolved maven identifiers (same modstore path -> one
  overwrites the other), which mainly hits small/library/Fabric-converted mods
  whose metadata cannot be resolved.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .../spec_model/module/Module.struct.ts         | 18 +++++++++++++++++-
 .../module/ToggleableModule.struct.ts          |  9 +++++++++
 .../module/forgemod/ForgeMod113.struct.ts      | 18 ++++++++++++++----
 3 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/src/structure/spec_model/module/Module.struct.ts b/src/structure/spec_model/module/Module.struct.ts
index e6004e5..16b62a4 100644
--- a/src/structure/spec_model/module/Module.struct.ts
+++ b/src/structure/spec_model/module/Module.struct.ts
@@ -191,15 +191,31 @@ export abstract class ModuleStructure extends BaseModelStructure<Module> {
             await this.invokeClaritas(moduleCandidates)
     
             // Process Modules
+            const idToFile = new Map<string, string>()
             for(const candidate of moduleCandidates) {
                 options?.preProcess?.(candidate)
                 const mdl = await this.parseModule(candidate.file, candidate.filePath, candidate.stats)
                 options?.postProcess?.(mdl)
+
+                // Two modules resolving to the same maven identifier map to the
+                // same modstore path — one would silently overwrite the other.
+                // This commonly hits small/library/Fabric-converted mods whose
+                // metadata cannot be resolved, so they fall back to a generated
+                // group + filename-derived id. Warn so it is not silent.
+                const existing = idToFile.get(mdl.id)
+                if(existing != null) {
+                    this.logger.warn(`Duplicate module id "${mdl.id}" from "${candidate.file}" and "${existing}". `
+                        + 'One will overwrite the other. This usually means metadata could not be resolved '
+                        + '(bad/missing mods.toml, Claritas failure). Verify both mods are included correctly.')
+                } else {
+                    idToFile.set(mdl.id, candidate.file)
+                }
+
                 accumulator.push(mdl)
             }
 
         }
-        
+
         return accumulator
 
     }
